{
  "name": "vocabulary",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Local CSV vocabulary collections and the Word by word review app (React + rspack)",
  "scripts": {
    "dev": "rspack serve",
    "build": "npm run data:index && NODE_ENV=production rspack build",
    "data:index": "node scripts/data-index.mjs",
    "start": "python3 scripts/serve.py",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "site": "node scripts/site.mjs",
    "deploy": "node scripts/deploy-pages.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@rspack/cli": "^1.7.12",
    "@rspack/core": "^1.7.12",
    "@rspack/plugin-react-refresh": "^1.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.11.0",
    "postcss": "^8.5.28",
    "postcss-loader": "^8.2.1",
    "react-refresh": "^0.19.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
